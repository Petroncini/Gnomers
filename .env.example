# Copie para .env e preencha. O .env não vai para o git.
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_CALLBACK_PORT=8080

# Back-end (opcionais)
# live | record | replay | fake
GNOMERS_MCP_MODE=live
# 0 para incluir mercados fechados na busca (útil à noite; o createCart ainda recusa fechados)
GNOMERS_ONLY_OPEN=1
# LLM (interpretar itens, normalizar produtos, chat). Sem chave, o back-end usa as heurísticas.
# OpenRouter: https://openrouter.ai/keys. Teste: cd backend && uv run python -m app.llm "2 leites integral italac"
OPENROUTER_API_KEY=
# Alternativa: API da Anthropic direto (usada só se não houver chave do OpenRouter)
ANTHROPIC_API_KEY=
# Modelos (opcional). Padrão no OpenRouter: anthropic/claude-haiku-5.5 (lote) e anthropic/claude-opus-5.5 (chat)
# GNOMERS_LLM_FAST=
# GNOMERS_LLM_STRONG=
