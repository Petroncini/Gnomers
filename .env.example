# Copie para .env e preencha. O .env não vai para o git.
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_CALLBACK_PORT=8080

# Back-end (opcionais)
# live | record | replay | fake
GNOMERS_MCP_MODE=live
# 0 para incluir mercados fechados na busca (útil à noite; o createCart ainda recusa fechados)
GNOMERS_ONLY_OPEN=1
# Chave da API da Anthropic para as tarefas do LLM; sem ela o back-end usa as heurísticas
ANTHROPIC_API_KEY=
