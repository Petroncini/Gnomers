{
  "name": "gnomers-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:api && tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../contract/openapi.json -o src/api-types.ts",
    "check:api": "openapi-typescript ../contract/openapi.json -o node_modules/.cache/api-types.ts && diff -q src/api-types.ts node_modules/.cache/api-types.ts"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
